# Required for auth (generate: openssl rand -base64 32)
NEXTAUTH_SECRET=replace_with_a_long_random_string_at_least_32_chars
NEXTAUTH_URL=http://localhost:3000

# Optional demo login (must match sign-in form if you use env-only account)
AUTH_EMAIL=demo@example.com
AUTH_PASSWORD=your_demo_password

NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
CENSUS_API_KEY=your_census_api_key_here
PLACES_API_KEY=your_google_places_api_key_here
